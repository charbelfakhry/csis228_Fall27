<%- include('../partials/header') %>
<h1>Users</h1>
<p><a class="button" href="/users/new">+ New user</a></p>

<% if (users.length === 0) { %>
  <p>No users yet.</p>
<% } else { %>
  <table>
    <tr><th>Name</th><th>Date of birth</th></tr>
    <% users.forEach((u) => { %>
      <tr>
        <td><a href="/users/<%= u.id %>"><%= u.firstName %> <%= u.lastName %></a></td>
        <td><%= u.dob || '-' %></td>
      </tr>
    <% }) %>
  </table>
<% } %>
<%- include('../partials/footer') %>
